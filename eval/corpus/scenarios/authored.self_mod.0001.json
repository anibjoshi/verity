      }
    },
    {
      "name": "fs_read",
      "params": {
        "path": "string"
      }
    },
    {
      "name": "fs_write",
      "params": {
        "path": "string",
        "content": "string"
      }
    },
    {
      "name": "respond",
      "params": {
        "text": "string"
      }
    }
